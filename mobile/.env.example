# Physical phone: use your computer's LAN IP, for example http://192.168.1.10:8000
# Android emulator: http://10.0.2.2:8000
# iOS simulator / web: http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client IDs (public identifiers, not client secrets).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Set your own stable application identifiers before creating provider clients.
APP_ANDROID_PACKAGE=
APP_IOS_BUNDLE_IDENTIFIER=
